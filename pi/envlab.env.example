# Copy to ~/envlab/.env on the kiosk Pi. Ask the team for real values; never commit the filled-in file.

# Dewin presence (pi/dewin_presence.py): the kiosk submits location:update for checked-in people
DEWIN_API_URL=http://127.0.0.1:8765
KIOSK_LAT=25.7617
KIOSK_LON=-80.1918
KIOSK_ACCURACY_M=5
DEWIN_INTERVAL_S=5
# per-person tokens live in ~/envlab/dewin_tokens.json: {"<person_id>": "<personal api token>"}

# Kiosk's own visit record in Supabase (pi/cloudsync.py), optional legacy path
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_publishable_...
NODE_ID=pi5-kiosk
