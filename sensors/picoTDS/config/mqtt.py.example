# MQTT Configuration for PicoTDS
# UPDATE THESE WITH YOUR MQTT BROKER DETAILS
# Then rename this file to mqtt.py

# Broker Discovery
# Set to True to automatically discover MQTT broker on the network
# Set to False to use the specific MQTT_BROKER address below
USE_BROKER_DISCOVERY = True
DISCOVERY_TIMEOUT = 15         # How long to scan for broker (seconds)

# MQTT Broker Settings (fallback if discovery disabled or fails)
MQTT_BROKER = "192.168.1.100"  # IP address of your MQTT broker
MQTT_PORT = 1883               # Standard MQTT port (1883 for unencrypted, 8883 for TLS)
MQTT_CLIENT_ID = "picotds"     # Unique client ID (will append random if needed)
MQTT_USER = "mqtt_user"        # MQTT username (leave empty if no auth)
MQTT_PASSWORD = "mqtt_password" # MQTT password (leave empty if no auth)

# MQTT Topic Configuration
MQTT_BASE_TOPIC = "picotds"    # Base topic for all messages
MQTT_TDS_TOPIC = "tds"         # Topic for TDS readings
MQTT_VOLTAGE_TOPIC = "voltage" # Topic for voltage readings
MQTT_TEMP_TOPIC = "temperature" # Topic for temperature readings
MQTT_STATUS_TOPIC = "status"   # Topic for device status (online/offline)

# QoS Level (0=at most once, 1=at least once, 2=exactly once)
MQTT_QOS = 1

# Retain messages (broker keeps last message)
MQTT_RETAIN = True

# Home Assistant Auto-Discovery
ENABLE_HA_DISCOVERY = True     # Enable Home Assistant auto-discovery
HA_DISCOVERY_PREFIX = "homeassistant"  # HA discovery topic prefix

# Publishing Interval (seconds)
MQTT_PUBLISH_INTERVAL = 10     # How often to publish readings (0 = every reading)

# Connection Settings
MQTT_KEEPALIVE = 60            # Keep-alive interval in seconds
MQTT_RECONNECT_DELAY = 5       # Delay between reconnection attempts
