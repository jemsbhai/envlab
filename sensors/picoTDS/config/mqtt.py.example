# Copy to config/mqtt.py ONLY if that private file does not already exist.
# Existing private configs need the new deployment fields added manually.
MQTT_BROKER = "10.104.0.82"
MQTT_PORT = 1883
MQTT_USER = "sensor"
MQTT_PASSWORD = "GET_PRIVATELY_FROM_SERGE"  # Never commit the real password.

# Ready one-board PUBLIC demo identity, enrolled by Serge. Change this for a
# second board and ask Serge to enroll it. None selects a stable MAC-derived ID.
MQTT_DEVICE_ID = "pico-water-01"
MQTT_LOCATION_ID = "demo-venue"
# DEMO FIXTURE coordinates shared with the phone demo mode, not measured GPS.
# Set the actual deployment coordinates when using real phone GPS.
MQTT_LATITUDE = 25.7617
MQTT_LONGITUDE = -80.1918

MQTT_PUBLISH_INTERVAL = 5
MQTT_KEEPALIVE = 60
MQTT_RECONNECT_DELAY = 5
MQTT_TDS_CALIBRATED = False  # Change only after actual calibration is confirmed.
MQTT_CLOCK_SYNCED = False   # Leave False unless the board's UTC clock was set.

# Transport is fixed: env/v1/<device_id>/telemetry, QoS 1, retain false.
# No HA, broker discovery, status messages, or Last Will are sent.
