# Run `python scripts/init_env.py` to create .env with random passwords.
SENSOR_PASSWORD=replace-with-random-password
PIPELINE_PASSWORD=replace-with-random-password
HA_PASSWORD=replace-with-random-password
VIEWER_PASSWORD=replace-with-random-password
PORTAINER_ADMIN_PASSWORD=replace-with-random-password
HA_ADMIN_PASSWORD=replace-with-random-password
API_CURSOR_SECRET=replace-with-random-password
API_DEMO_TOKEN=replace-with-random-password
API_SECOND_TOKEN=replace-with-random-password
API_HOST_PORT=8765

# Ports on the 1 GB Pi; only MQTT is exposed to the LAN by default.
MQTT_PORT=1883
NATS_PORT=4222
MONITOR_PORT=8222
WS_PORT=8080

# Worker settings. The SQLite volume survives container restarts.
SENSOR_EXPIRE_SECONDS=30
WINDOW_SECONDS=60
HISTORY_DAYS=90
SIM_DEVICES=3
SIM_INTERVAL=5
