{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pico telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "location_id",
    "boot_id",
    "seq",
    "measured_at",
    "source",
    "readings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "$ref": "#/$defs/id"
    },
    "location_id": {
      "$ref": "#/$defs/id"
    },
    "boot_id": {
      "$ref": "#/$defs/id"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "measured_at": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "enum": [
        "sensor",
        "simulated"
      ]
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "metric",
          "value",
          "unit"
        ],
        "properties": {
          "sensor_id": {
            "$ref": "#/$defs/id"
          },
          "metric": {
            "$ref": "#/$defs/id"
          },
          "value": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          },
          "unit": {
            "type": "string",
            "maxLength": 24
          },
          "quality": {
            "enum": [
              "ok",
              "uncalibrated",
              "invalid"
            ]
          },
          "medium": {
            "enum": [
              "air",
              "water"
            ]
          }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
    }
  },
  "$comment": "Position and medium are optional for legacy transport compatibility, but required for all new firmware participating in spatial exposure matching."
}
